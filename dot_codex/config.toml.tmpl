{{- $home := trimSuffix "/" .chezmoi.homeDir -}}
# ~/.codex/config.toml —— 由 chezmoi 生成
# 注意：codex 自己会往这个文件里追加 [projects."…"]（目录信任）和 [hooks.state] 段，
# 这些是机器相关的，不在 Git 里；chezmoi apply 会重置它们，重开 codex 重新 trust 一次即可。
# 想保留 codex 写的内容： chezmoi merge ~/.codex/config.toml
model_catalog_json = "~/.codex/model-catalog.local.json"

model_provider = "dashscope"
model = "qwen3.8-27b"
model_reasoning_effort = "medium"

approval_policy = "on-request"
sandbox_mode = "workspace-write"
disable_response_storage = true

[model_providers.dashscope]
name = "Dashscope"
base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
# 密钥来自环境变量 DASHSCOPE_API_KEY（shell 配置由 chezmoi 生成 / Windows 用户环境变量由 bootstrap 写入）
env_key = "DASHSCOPE_API_KEY"
wire_api = "responses"
requires_openai_auth = false

[desktop]
conversationDetailMode = "STEPS_PROSE"
sansFontSize = 14
codeFontSize = 13
ambient-suggestions-enabled = false
{{- if eq .chezmoi.os "windows" }}

[windows]
sandbox = "unelevated"
{{- end }}

[features]
hooks = true

[projects.'{{ if eq .chezmoi.os "windows" }}{{ lower (replace "/" "\\" $home) }}{{ else }}{{ $home }}{{ end }}']
trust_level = "trusted"

[notice]
hide_world_writable_warning = true
